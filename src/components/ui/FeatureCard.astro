---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    title: string;
    description: string;
    image: ImageMetadata;
    imageAlt: string;
}

const { title, description, image, imageAlt } = Astro.props;
---

<div
    class="@container bg-white hover:bg-primary rounded-2xl p-6 transition-colors duration-300 group/card 2xl:min-h-59.25"
>
    <div class="flex flex-col @min-[20rem]:flex-row gap-4 items-start">
    <div class="min-w-0 flex-1">
        <h3
            class="text-lg 2xl:text-xl font-bold mb-2 text-primary group-hover/card:text-white"
        >
            {title}
        </h3>
        <p
            class="text-gray-500 group-hover/card:text-white text-sm 2xl:text-base leading-relaxed font-general-sans"
        >
            {description}
        </p>
    </div>
    <Image
        src={image}
        alt={imageAlt}
        width={128}
        height={128}
        densities={[1, 2]}
        fit="cover"
        format="webp"
        loading="lazy"
        decoding="async"
        class="w-32 h-32 object-cover rounded-xl shrink-0"
    />
    </div>
</div>
