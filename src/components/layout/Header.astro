---
import DesktopDropdown from "@/components/layout/header/DesktopDropdown.astro";
import HeaderBar from "@/components/layout/header/HeaderBar.astro";
import MobileNavigation from "@/components/layout/header/MobileNavigation.astro";
---

<div id="header-navigation">
    <HeaderBar />
    <DesktopDropdown />
    <MobileNavigation />
</div>

<script>
    // Los listeners van en `document`, así siguen funcionando después de cada
    // navegación del ClientRouter sin tener que volver a registrarlos.

    const header = () => document.getElementById("header-navigation");
    const isOpen = (menu: "mobile" | "desktop") => header()?.hasAttribute(`data-${menu}-open`) ?? false;

    function setMobileMenu(open: boolean) {
        const button = document.getElementById("mobile-menu-button");
        const menu = document.getElementById("mobile-menu");
        if (!button || !menu) return;

        header()?.toggleAttribute("data-mobile-open", open);
        button.setAttribute("aria-expanded", String(open));
        button.setAttribute("aria-label", open ? "Cerrar menú de navegación" : "Abrir menú de navegación");
        menu.inert = !open;

        // El menú ocupa toda la pantalla: bloqueamos el scroll y el contenido de detrás.
        document.documentElement.style.overflow = open ? "hidden" : "";
        document.querySelectorAll<HTMLElement>("main, footer").forEach((element) => {
            element.inert = open;
        });

        if (open) menu.querySelector("a")?.focus();
    }

    function setDesktopMenu(open: boolean) {
        const button = document.getElementById("desktop-menu-button");
        const menu = document.getElementById("desktop-menu");
        if (!button || !menu) return;

        header()?.toggleAttribute("data-desktop-open", open);
        button.setAttribute("aria-expanded", String(open));
        button.setAttribute("aria-label", open ? "Cerrar menú principal" : "Abrir menú principal");
        menu.inert = !open;

        if (open) {
            const activeTab = menu.querySelector<HTMLElement>('[role="tab"][aria-selected="true"]');
            if (activeTab) {
                selectTab(activeTab);
                activeTab.focus();
            }
        }
    }

    function selectTab(selected: HTMLElement) {
        const tabs = document.querySelectorAll<HTMLElement>('#desktop-menu [role="tab"]');
        tabs.forEach((tab) => {
            const isSelected = tab === selected;
            tab.classList.toggle("active", isSelected);
            tab.setAttribute("aria-selected", String(isSelected));
            tab.tabIndex = isSelected ? 0 : -1;
            const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "");
            if (panel) panel.hidden = !isSelected;
        });

        // Mueve la barrita blanca debajo de la pestaña activa.
        const bar = document.querySelector<HTMLElement>("#desktop-menu .active-bar");
        if (bar) {
            bar.style.width = `${selected.offsetWidth}px`;
            bar.style.transform = `translateX(${selected.offsetLeft}px)`;
        }
    }

    function closeMenus() {
        setMobileMenu(false);
        setDesktopMenu(false);
    }

    document.addEventListener("click", (event) => {
        const target = event.target as Element;

        if (target.closest("#mobile-menu-button")) {
            setMobileMenu(!isOpen("mobile"));
        } else if (target.closest("#desktop-menu-button")) {
            setDesktopMenu(!isOpen("desktop"));
        } else if (target.closest('#desktop-menu [role="tab"]')) {
            selectTab(target.closest<HTMLElement>('[role="tab"]')!);
        } else if (target.closest("#header-navigation a[href]")) {
            closeMenus();
        } else if (isOpen("desktop") && !target.closest("#desktop-menu")) {
            setDesktopMenu(false);
        }
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
            if (isOpen("mobile")) {
                setMobileMenu(false);
                document.getElementById("mobile-menu-button")?.focus();
            }
            if (isOpen("desktop")) {
                setDesktopMenu(false);
                document.getElementById("desktop-menu-button")?.focus();
            }
            return;
        }

        // Flechas izquierda/derecha para moverse entre pestañas.
        const tab = (event.target as Element).closest<HTMLElement>('#desktop-menu [role="tab"]');
        if (!tab || (event.key !== "ArrowLeft" && event.key !== "ArrowRight")) return;

        event.preventDefault();
        const tabs = Array.from(document.querySelectorAll<HTMLElement>('#desktop-menu [role="tab"]'));
        const step = event.key === "ArrowRight" ? 1 : -1;
        const next = tabs[(tabs.indexOf(tab) + step + tabs.length) % tabs.length];
        selectTab(next);
        next.focus();
    });

    // Si la pantalla cambia entre móvil y escritorio con un menú abierto, lo cerramos.
    window.matchMedia("(min-width: 64rem)").addEventListener("change", closeMenus);

    // Antes de cambiar de página, deja todo cerrado (sobre todo el scroll bloqueado).
    document.addEventListener("astro:before-swap", closeMenus);
</script>
