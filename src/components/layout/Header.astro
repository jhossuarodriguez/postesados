---
import DesktopDropdown from "@/components/layout/header/DesktopDropdown.astro";
import HeaderBar from "@/components/layout/header/HeaderBar.astro";
import MobileNavigation from "@/components/layout/header/MobileNavigation.astro";
---

<div id="header-navigation">
    <HeaderBar />
    <DesktopDropdown />
    <MobileNavigation />
</div>

<script>
    let cleanupHeader: (() => void) | undefined;

    const initializeHeader = () => {
        cleanupHeader?.();
        cleanupHeader = undefined;

        const root = document.getElementById("header-navigation");
        if (!root) return;

        const mobileMenu = root.querySelector<HTMLElement>("#mobile-menu");
        const mobileButton = root.querySelector<HTMLButtonElement>("#mobile-menuBtn");
        const dropdown = root.querySelector<HTMLElement>("#menu-dropdownn");
        const desktopButton = root.querySelector<HTMLButtonElement>("#menuBtn");
        const fallback = root.querySelector<HTMLDetailsElement>("#header-fallback");
        if (!mobileMenu || !mobileButton || !dropdown || !desktopButton || !fallback) return;

        const controller = new AbortController();
        const { signal } = controller;
        const desktopViewport = window.matchMedia("(min-width: 64rem)");
        const controls = root.querySelectorAll<HTMLElement>("[data-header-toggle]");
        const tabs = Array.from(dropdown.querySelectorAll<HTMLButtonElement>(".tab"));
        const panels = dropdown.querySelectorAll<HTMLElement>(".nav-panel");
        const slidingBar = dropdown.querySelector<HTMLElement>(".active-bar");
        let mobileOpen = false;
        let desktopOpen = false;
        let activeTab = 0;
        let releasePage: (() => void) | undefined;

        const changeTab = (index: number) => {
            const selectedTab = tabs[index];
            if (!selectedTab) return;
            activeTab = index;

            tabs.forEach((tab, position) => {
                const selected = position === index;
                tab.classList.toggle("active", selected);
                tab.setAttribute("aria-selected", String(selected));
                tab.tabIndex = selected ? 0 : -1;
            });

            panels.forEach((panel) => {
                panel.hidden = panel.id !== selectedTab.getAttribute("aria-controls");
            });
            if (slidingBar) {
                slidingBar.style.width = `${selectedTab.offsetWidth}px`;
                slidingBar.style.transform = `translateX(${selectedTab.offsetLeft}px)`;
            }
        };

        const closeMenus = (restoreFocus = true) => {
            const wasOpen = mobileOpen || desktopOpen;
            mobileOpen = false;
            desktopOpen = false;
            delete root.dataset.mobileOpen;
            delete root.dataset.desktopOpen;
            root.removeAttribute("role");
            root.removeAttribute("aria-modal");
            root.removeAttribute("aria-label");
            mobileMenu.inert = true;
            dropdown.inert = true;
            mobileButton.setAttribute("aria-expanded", "false");
            mobileButton.setAttribute("aria-label", "Abrir menú de navegación");
            desktopButton.setAttribute("aria-expanded", "false");
            desktopButton.setAttribute("aria-label", "Abrir menú principal");
            releasePage?.();
            releasePage = undefined;

            if (wasOpen && restoreFocus) {
                const trigger = desktopViewport.matches ? desktopButton : mobileButton;
                trigger.focus({ preventScroll: true });
            }
        };

        mobileButton.addEventListener("click", () => {
            if (mobileOpen) return closeMenus();
            if (desktopViewport.matches) return;
            closeMenus(false);
            mobileOpen = true;
            root.dataset.mobileOpen = "";
            root.setAttribute("role", "dialog");
            root.setAttribute("aria-modal", "true");
            root.setAttribute("aria-label", "Menú de navegación");
            mobileMenu.inert = false;
            mobileMenu.scrollTop = 0;
            mobileButton.setAttribute("aria-expanded", "true");
            mobileButton.setAttribute("aria-label", "Cerrar menú de navegación");

            // Include the header controls in the dialog, and preserve existing inert regions.
            const inertElements: HTMLElement[] = [];
            let branch: HTMLElement = root;
            while (branch.parentElement && branch !== document.body) {
                for (const sibling of branch.parentElement.children) {
                    if (sibling instanceof HTMLElement && sibling !== branch && !sibling.inert) {
                        sibling.inert = true;
                        inertElements.push(sibling);
                    }
                }
                branch = branch.parentElement;
            }

            const body = document.body;
            const lenisPrevent = body.getAttribute("data-lenis-prevent");
            const scrollStyles = [document.documentElement, body].flatMap((element) =>
                ["overflow-x", "overflow-y"].map((property) => ({
                    element,
                    property,
                    value: element.style.getPropertyValue(property),
                    priority: element.style.getPropertyPriority(property),
                })),
            );
            // Lenis must leave wheel/touch events to the panel's native scrolling.
            body.setAttribute("data-lenis-prevent", "");
            scrollStyles.forEach(({ element, property }) => {
                element.style.setProperty(property, "hidden");
            });
            releasePage = () => {
                inertElements.forEach((element) => { element.inert = false; });
                scrollStyles.forEach(({ element, property, value, priority }) => {
                    element.style.setProperty(property, value, priority);
                });
                if (lenisPrevent === null) body.removeAttribute("data-lenis-prevent");
                else body.setAttribute("data-lenis-prevent", lenisPrevent);
            };
            mobileMenu.querySelector<HTMLAnchorElement>("a[href]")?.focus({ preventScroll: true });
        }, { signal });

        desktopButton.addEventListener("click", () => {
            if (desktopOpen) return closeMenus();
            if (!desktopViewport.matches) return;
            closeMenus(false);
            desktopOpen = true;
            root.dataset.desktopOpen = "";
            dropdown.inert = false;
            desktopButton.setAttribute("aria-expanded", "true");
            desktopButton.setAttribute("aria-label", "Cerrar menú principal");
            changeTab(activeTab);
            tabs[activeTab]?.focus({ preventScroll: true });
        }, { signal });

        tabs.forEach((tab, index) => {
            tab.addEventListener("click", () => changeTab(index), { signal });
            tab.addEventListener("keydown", (event) => {
                let nextIndex = index;
                if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
                else if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
                else if (event.key === "Home") nextIndex = 0;
                else if (event.key === "End") nextIndex = tabs.length - 1;
                else return;
                event.preventDefault();
                changeTab(nextIndex);
                tabs[nextIndex]?.focus();
            }, { signal });
        });

        root.addEventListener("click", (event) => {
            if (event.target instanceof Element && event.target.closest("a[href]")) closeMenus();
        }, { signal });

        document.addEventListener("click", (event) => {
            if (desktopOpen && event.target instanceof Node &&
                !dropdown.contains(event.target) && !desktopButton.contains(event.target)) {
                closeMenus(dropdown.contains(document.activeElement));
            }
        }, { signal });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && (mobileOpen || desktopOpen)) {
                event.preventDefault();
                closeMenus();
                return;
            }
            if (!mobileOpen || event.key !== "Tab") return;

            const focusable = Array.from(root.querySelectorAll<HTMLElement>(
                'a[href], button:not(:disabled), [tabindex="0"]',
            )).filter((element) => !element.closest("[inert]") &&
                element.tabIndex >= 0 && element.getClientRects().length > 0 &&
                getComputedStyle(element).visibility !== "hidden");
            const first = focusable[0] ?? mobileButton;
            const last = focusable[focusable.length - 1] ?? mobileButton;
            const active = document.activeElement;
            if (!root.contains(active) || (event.shiftKey ? active === first : active === last)) {
                event.preventDefault();
                (event.shiftKey ? last : first).focus();
            }
        }, { signal });

        document.addEventListener("focusin", (event) => {
            if (mobileOpen && event.target instanceof Node && !root.contains(event.target)) {
                mobileButton.focus({ preventScroll: true });
            } else if (desktopOpen && event.target instanceof Node &&
                !dropdown.contains(event.target) && event.target !== desktopButton) {
                closeMenus(false);
            }
        }, { signal });

        desktopViewport.addEventListener("change", () => closeMenus(), { signal });
        window.addEventListener("resize", () => changeTab(activeTab), { signal });

        fallback.open = false;
        fallback.hidden = true;
        controls.forEach((control) => { control.hidden = false; });
        changeTab(0);
        cleanupHeader = () => {
            closeMenus(false);
            controller.abort();
            fallback.hidden = false;
            controls.forEach((control) => { control.hidden = true; });
        };
    };

    // Astro runs this bundled script once; only the lifecycle listeners persist.
    document.addEventListener("astro:page-load", initializeHeader);
    document.addEventListener("astro:before-swap", () => {
        cleanupHeader?.();
        cleanupHeader = undefined;
    });
    initializeHeader();
</script>
