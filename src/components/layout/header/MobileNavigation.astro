---
import NextButton from "@/assets/icons/nextButton.svg";
import { navItems } from "@/data/navigation";
---

<nav
    class="fixed inset-0 h-dvh w-full overflow-y-auto overscroll-contain bg-secondary z-40 transform -translate-y-full transition-[opacity,translate] duration-500 ease-in-out shadow-xl lg:hidden opacity-0 invisible"
    id="mobile-menu"
    aria-label="Navegación móvil"
    data-lenis-prevent
    inert
>
    <div class="flex flex-col min-h-full pt-34 pb-8 px-6">
        <div class="flex flex-col gap-2">
            {
                navItems.map((link, index) =>
                    index === navItems.length - 1 ? (
                        <a
                            href={link.href}
                            class="mobile-nav-link mt-20 py-4 px-6 text-lg font-semibold text-white bg-dark rounded-full text-center shadow-lg"
                            style={`--nav-index: ${index}`}
                        >
                            {link.label}
                            <NextButton aria-hidden="true" class="inline-block size-4 ml-2" />
                        </a>
                    ) : (
                        <a
                            href={link.href}
                            class="mobile-nav-link group flex items-center gap-3 py-4 px-4 text-lg font-medium text-white border-b border-white/25"
                            style={`--nav-index: ${index}`}
                        >
                            <div class="w-full flex justify-between items-center size-4">
                                {link.label}
                                <div class="flex justify-center items-center rounded-sm border border-white">
                                    <NextButton aria-hidden="true" class="size-4" />
                                </div>
                            </div>
                        </a>
                    ),
                )
            }
        </div>
    </div>
</nav>

<style>
    :global([data-mobile-open]) #mobile-menu {
        translate: 0 0;
        opacity: 1;
        visibility: visible;
    }

    .mobile-nav-link {
        opacity: 0;
        transform: translateY(20px);
        transition:
            opacity 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
            transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    :global([data-mobile-open]) .mobile-nav-link {
        opacity: 1;
        transform: translateY(0);
        transition-delay: calc(200ms + var(--nav-index) * 80ms);
    }

    :global([data-mobile-open]) .mobile-nav-link:focus {
        transition: none;
    }

    @media (prefers-reduced-motion: reduce) {
        :global([data-mobile-open]) .mobile-nav-link {
            transition-delay: 0s;
        }
    }
</style>
