---
import NextButton from "@/assets/icons/nextButton.svg";
import { navItems } from "@/data/navigation";
---

<nav
    class="fixed inset-0 h-dvh w-full overflow-y-auto overscroll-contain bg-secondary z-40 transform -translate-y-full transition-[opacity,translate] duration-500 ease-in-out shadow-xl lg:hidden opacity-0 invisible"
    id="mobile-menu"
    aria-label="Navegación móvil"
    inert
>
    <ul class="flex flex-col gap-2 pt-34 pb-8 px-6">
        {
            navItems.map((link, index) => (
                <li class="mobile-nav-link" style={`--nav-index: ${index}`}>
                    <a
                        href={link.href}
                        class="flex items-center justify-between py-4 px-4 text-lg font-medium text-white border-b border-white/25"
                    >
                        {link.label}
                        <span class="flex items-center justify-center rounded-sm border border-white">
                            <NextButton aria-hidden="true" class="size-4" />
                        </span>
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<style>
    :global([data-mobile-open]) #mobile-menu {
        translate: 0 0;
        opacity: 1;
        visibility: visible;
    }

    /* Los enlaces entran uno tras otro al abrir el menú. */
    .mobile-nav-link {
        opacity: 0;
        transform: translateY(20px);
        transition:
            opacity 0.4s ease-out,
            transform 0.4s ease-out;
    }

    :global([data-mobile-open]) .mobile-nav-link {
        opacity: 1;
        transform: translateY(0);
        transition-delay: calc(200ms + var(--nav-index) * 80ms);
    }
</style>
