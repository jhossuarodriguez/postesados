---
import { Image } from "astro:assets";
import Menu from "@/assets/icons/Menu.svg";
import MoveRight from "@/assets/icons/MoveRight.svg";
import X from "@/assets/icons/XButton.svg";
import logoPostesados from "@/assets/images/branding/logo-postesados.webp";
import Container from "@/components/layout/Container.astro";
import { navItems } from "@/data/navigation";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
// "Servicios" queda marcado también dentro de /servicios/algo.
const isActive = (href: string) =>
    pathname === href || (href !== "/" && pathname.startsWith(href + "/"));
---

<Container
    as="header"
    class="fixed mt-5 inset-x-0 shadow-3xl z-50 bg-secondary rounded-xl"
    id="main-header"
>
    <nav class="py-2 relative z-50" aria-label="Navegación principal">
        <div class="flex justify-between items-center">
            <div class="flex items-center gap-1">
                <button
                    type="button"
                    id="desktop-menu-button"
                    class="hidden lg:flex items-center justify-center size-12 mr-7 rounded-full cursor-pointer relative hover:bg-quaternary transition-colors duration-200"
                    aria-label="Abrir menú principal"
                    aria-expanded="false"
                    aria-controls="desktop-menu"
                >
                    <Menu aria-hidden="true" class="menu-icon text-white absolute size-6 transition-all duration-300" />
                    <X aria-hidden="true" class="close-icon text-white absolute size-6 opacity-0 scale-0 transition-all duration-300" />
                </button>

                {
                    navItems
                        .filter((item) => !item.hideOnDesktop)
                        .map((item) => (
                            <a
                                href={item.href}
                                aria-current={pathname === item.href ? "page" : undefined}
                                class:list={[
                                    "hidden lg:inline-flex lg:min-h-12 lg:items-center px-6 py-2 text-white text-base rounded-full transition-colors hover:bg-quaternary hover:opacity-100",
                                    isActive(item.href) ? "bg-quaternary" : "opacity-80",
                                ]}
                            >
                                {item.label}
                            </a>
                        ))
                }

                <a href="/" aria-label="Postesados, inicio">
                    <Image
                        src={logoPostesados}
                        alt=""
                        class="h-16 w-auto lg:translate-x-14 xl:translate-x-24 2xl:translate-x-20"
                        width={83}
                        densities={[1, 2]}
                        loading="eager"
                        format="webp"
                    />
                </a>
            </div>

            <div class="flex items-center gap-2">
                <a
                    href="/contact"
                    id="contact-button"
                    class="group flex min-h-12 items-center gap-2 text-white font-bold text-sm rounded-full opacity-80 hover:opacity-100 bg-quaternary px-3 py-2"
                    aria-current={pathname === "/contact" ? "page" : undefined}
                >
                    Contáctanos
                    <MoveRight aria-hidden="true" class="hidden lg:inline-block ml-2 group-hover:translate-x-1 duration-100" />
                </a>

                <button
                    type="button"
                    id="mobile-menu-button"
                    class="lg:hidden flex items-center justify-center size-12 rounded-full cursor-pointer relative transition-colors duration-300"
                    aria-label="Abrir menú de navegación"
                    aria-expanded="false"
                    aria-controls="mobile-menu"
                >
                    <Menu aria-hidden="true" class="menu-icon text-white size-6 transition-all duration-300" />
                    <X aria-hidden="true" class="close-icon text-white absolute size-6 opacity-0 scale-0 transition-all duration-300" />
                </button>
            </div>
        </div>
    </nav>
</Container>

<style>
    :global([data-desktop-open]) #desktop-menu-button {
        background-color: var(--color-quaternary);
    }

    :global([data-mobile-open]) #mobile-menu-button,
    :global([data-mobile-open]) #contact-button {
        background-color: var(--color-dark);
    }

    :global([data-desktop-open]) #desktop-menu-button .menu-icon,
    :global([data-mobile-open]) #mobile-menu-button .menu-icon {
        opacity: 0;
        scale: 0;
    }

    :global([data-desktop-open]) #desktop-menu-button .close-icon,
    :global([data-mobile-open]) #mobile-menu-button .close-icon {
        opacity: 1;
        scale: 1;
    }
</style>
