---
import { Image } from "astro:assets";

import MoveRight from "@/assets/icons/MoveRight.svg";
import { dropdownPanels, dropdownTabs } from "@/data/navigation";
---

<!-- Desktop Dropdown Menu -->
<div
    class="fixed top-24 left-1/2 -translate-x-1/2 w-[93%] md:w-[94%] md:max-w-335 lg:max-w-400 bg-secondary rounded-xl shadow-xl z-40 transform -translate-y-8 opacity-0 invisible transition-all duration-300 ease-out hidden lg:block"
    id="menu-dropdownn"
>
    <div class="nav-container px-8 py-8 mt-8">
        <!-- Tabs -->
        <ul
            class="flex items-center gap-0 relative list-none p-0 mb-6 border-b border-white/15"
            role="tablist"
            aria-label="Navegación de secciones"
        >
            {
                dropdownTabs.map((tab, index) => (
                    <li role="presentation">
                        <button
                            id={tab.id}
                            type="button"
                            aria-label={`Mostrar ${tab.label}`}
                            class={`tab bg-transparent border-none text-white/55 text-lg font-general-sans py-3 px-5 cursor-pointer transition-colors duration-200 whitespace-nowrap hover:text-white/85${index === 0 ? " active" : ""}`}
                            role="tab"
                            tabindex="0"
                            aria-selected={index === 0 ? "true" : "false"}
                            aria-controls={tab.panelId}
                        >
                            <span class="tab-label">{tab.label}</span>
                        </button>
                    </li>
                ))
            }
            <div
                class="active-bar absolute -bottom-px left-0 h-0.5 bg-white rounded-sm transition-[width,transform] duration-300 ease-in-out"
            >
            </div>
        </ul>

        {
            dropdownPanels.map((panel, index) => (
                <div
                    class="nav-panel flex justify-between w-full"
                    id={panel.id}
                    role="tabpanel"
                    aria-labelledby={panel.tabId}
                    hidden={index === 0 ? undefined : true}
                >
                    <ul class={panel.listClass}>
                        {panel.links.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    class={link.class}
                                    title={link.title}
                                    aria-label={link.title}
                                >
                                    <div class="flex-1 min-w-0">
                                        <p class="text-white text-base font-semibold leading-[1.3]">
                                            {link.label}
                                        </p>
                                        <p class="text-white/50 text-xs mt-1 leading-[1.3] font-general-sans">
                                            {link.description}
                                        </p>
                                    </div>
                                    <div class="flex items-center justify-center border border-white rounded-[10px] p-1 group-hover/section:bg-white">
                                        <MoveRight class="size-5 group-hover/section:text-secondary group-hover/section:translate-x-1 duration-75" />
                                    </div>
                                </a>
                            </li>
                        ))}
                    </ul>
                    <div class="flex h-80 2xl:h-117 relative">
                        <Image
                            class="w-160 2xl:w-190 object-cover rounded-2xl"
                            src={panel.image}
                            alt={panel.imageAlt}
                        />
                        <div class="inset-0 absolute bg-black/10 rounded-2xl"></div>
                        <div class="absolute inset-0">
                            <div class="w-full h-full flex flex-col gap-x-20 space-y-3 lg:space-y-0 pt-10 pl-6 pb-6">
                                <span class="text-white/80 font-bold text-base">
                                    {panel.overviewLabel}
                                </span>
                                <p class="text-white font-bold text-7xl tracking-tighter w-full">
                                    Abarcando <br /> el Futuro.
                                </p>
                                <div class="mb-5 flex mt-auto">
                                    <a
                                        href={panel.ctaHref}
                                        class="flex min-h-12 items-center gap-2 text-white font-bold text-sm rounded-full opacity-80 hover:opacity-100 border border-white/80 px-3 py-1 group"
                                        title={panel.ctaTitle}
                                        aria-label={panel.ctaTitle}
                                    >
                                        Ver mas
                                        <MoveRight class="lg:inline-block ml-2 hidden group-hover:translate-x-1 duration-100" />
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            ))
        }
    </div>
</div>

<div
    class="fixed inset-0 backdrop-blur-sm z-30 opacity-0 invisible transition-all duration-300 hidden lg:block"
    id="desktop-overlay"
>
</div>

<style>
    .tab.active {
        color: #ffffff;
    }
</style>
