---
import { Image } from "astro:assets";
import MoveRight from "@/assets/icons/MoveRight.svg";
import { dropdownPanels } from "@/data/navigation";
---

<nav
    class="fixed top-24 left-1/2 -translate-x-1/2 w-[93%] md:w-[94%] md:max-w-335 lg:max-w-400 max-h-[calc(100dvh-6rem)] overflow-y-auto overscroll-contain bg-secondary rounded-xl shadow-xl z-40 transform -translate-y-8 opacity-0 invisible transition-[opacity,translate] duration-300 ease-out hidden lg:block"
    id="desktop-menu"
    aria-label="Menú principal"
    inert
>
    <div class="px-8 py-8 mt-8">
        <div
            class="flex items-center relative mb-6 border-b border-white/15"
            role="tablist"
            aria-label="Secciones del menú"
        >
            {
                dropdownPanels.map((panel, index) => (
                    <button
                        id={`menu-tab-${index}`}
                        type="button"
                        role="tab"
                        class={`tab text-white/80 text-lg font-general-sans py-3 px-5 cursor-pointer transition-colors duration-200 whitespace-nowrap hover:text-white ${index === 0 ? "active" : ""}`}
                        tabindex={index === 0 ? 0 : -1}
                        aria-selected={index === 0 ? "true" : "false"}
                        aria-controls={`menu-panel-${index}`}
                    >
                        {panel.tab}
                    </button>
                ))
            }
            <span
                class="active-bar absolute -bottom-px left-0 h-0.5 bg-white rounded-sm transition-[width,transform] duration-300 ease-in-out"
                aria-hidden="true"
            ></span>
        </div>

        {
            dropdownPanels.map((panel, index) => (
                <div
                    class="nav-panel flex justify-between w-full"
                    id={`menu-panel-${index}`}
                    role="tabpanel"
                    aria-labelledby={`menu-tab-${index}`}
                    hidden={index !== 0}
                >
                    <ul class={panel.twoColumns ? "grid grid-cols-2 gap-x-12 content-start max-w-6xl" : "content-start"}>
                        {panel.links.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    class="group/section flex items-center justify-between gap-4 py-4 px-3 border-b border-white/8 rounded-lg transition-colors duration-200 hover:bg-quaternary/50 text-white/80 hover:text-white"
                                >
                                    <div class="flex-1 min-w-0">
                                        <p class="text-white text-base font-semibold leading-[1.3]">
                                            {link.label}
                                        </p>
                                        <p class="text-white/80 text-xs mt-1 leading-[1.3] font-general-sans">
                                            {link.description}
                                        </p>
                                    </div>
                                    <div class="flex items-center justify-center border border-white rounded-[10px] p-1 group-hover/section:bg-white">
                                        <MoveRight aria-hidden="true" class="size-5 group-hover/section:text-secondary group-hover/section:translate-x-1 duration-75" />
                                    </div>
                                </a>
                            </li>
                        ))}
                    </ul>
                    <div class="flex h-80 2xl:h-117 relative">
                        <Image
                            class="w-160 2xl:w-190 object-cover rounded-2xl"
                            src={panel.image}
                            alt={panel.imageAlt}
                            width={760}
                            widths={[480, 760, 1200]}
                            sizes="45vw"
                            format="webp"
                            loading="lazy"
                        />
                        <div class="inset-0 absolute bg-black/10 rounded-2xl"></div>
                        <div class="absolute inset-0 flex flex-col pt-10 pl-6 pb-6">
                            <span class="text-white/80 font-bold text-base">
                                {panel.overviewLabel}
                            </span>
                            <p class="text-white font-bold text-7xl tracking-tighter">
                                Abarcando <br /> el Futuro.
                            </p>
                            <div class="mb-5 mt-auto">
                                <a
                                    href={panel.ctaHref}
                                    class="group inline-flex min-h-12 items-center gap-2 text-white font-bold text-sm rounded-full opacity-80 hover:opacity-100 border border-white/80 px-3 py-1"
                                >
                                    Ver más
                                    <MoveRight aria-hidden="true" class="ml-2 group-hover:translate-x-1 duration-100" />
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            ))
        }
    </div>
</nav>

<div
    class="fixed inset-0 backdrop-blur-sm z-30 opacity-0 invisible transition-all duration-300 hidden lg:block"
    id="desktop-overlay"
    aria-hidden="true"
></div>

<style>
    :global([data-desktop-open]) #desktop-menu {
        translate: -50% -1rem;
        opacity: 1;
        visibility: visible;
    }

    :global([data-desktop-open]) #desktop-overlay {
        opacity: 1;
        visibility: visible;
    }

    .nav-panel[hidden] {
        display: none;
    }

    .tab.active {
        color: white;
    }
</style>
