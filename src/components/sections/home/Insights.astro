---
import InnovationCard from "@/components/sections/home/InnovationCard.astro";
import { innovations } from "@/data/home";
---

<section class="mt-20 flex w-full flex-col bg-tertiary pb-20 md:pb-28">
    <div class="mx-auto mt-10 flex w-full max-w-350 flex-col space-y-10 px-6 lg:px-10">
        <div class="rounded-full border border-gray-300 lg:px-6 px-3 py-2 w-48 lg:w-56 bg-white" data-reveal="up">
            <p class="flex justify-center items-center text-xs lg:text-base text-primary font-bold gap-2">
                ● Nuestros Servicios
            </p>
        </div>

        <div class="flex flex-col lg:flex-row items-center gap-x-20 space-y-3 lg:space-y-0" data-reveal="up">
            <h2 class="text-3xl lg:text-6xl text-primary w-full lg:max-w-4xl leading-tight">
                Ingeniería Avanzada que <br />
                <span class="font-bold">Impulsa el Desarrollo</span>
            </h2>
        </div>
    </div>

    <div class="mx-auto mt-12 grid w-full max-w-300 grid-cols-1 gap-6 px-6 md:grid-cols-2 lg:gap-8" data-reveal-children>
        {innovations.map((item) => <InnovationCard item={item} />)}
    </div>
</section>
