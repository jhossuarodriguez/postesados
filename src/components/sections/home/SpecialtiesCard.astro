---
import { Image } from "astro:assets";
import Briefcase from "@/assets/icons/briefcase.svg";
import { specialties, specialtiesImage } from "@/data/home";
---

<div class="lg:col-span-8 rounded-4xl overflow-hidden relative min-h-100 group transition-all duration-500 hover:shadow-2xl hover:-translate-y-1">
    <Image
        src={specialtiesImage}
        alt="Especialidades construcción"
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-1000 group-hover:scale-110"
    />
    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/40 to-black/10 group-hover:from-black/90 transition-all duration-500"></div>
    <div class="relative h-full flex items-end p-7 lg:p-10">
        <div class="flex items-center gap-5">
            <div class="bg-white/15 backdrop-blur-md p-2.5 flex items-center justify-center border border-white/20 group-hover:bg-white/25 transition-all duration-500">
                <Briefcase class="text-white size-6" />
            </div>
            <div class="space-y-2">
                <h3 class="text-white text-2xl font-bold">Especialidades</h3>
                <div class="flex flex-wrap gap-2">
                    {
                        specialties.map((specialty) => (
                            <span class="bg-white/15 backdrop-blur-sm px-3 py-1.5 rounded-full text-white/90 text-sm border border-white/10 hover:bg-white/25 transition-colors duration-300 cursor-default">
                                {specialty}
                            </span>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</div>
