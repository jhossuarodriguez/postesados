---
import NextButton from "@/assets/icons/nextButton.svg";
import PrevButton from "@/assets/icons/prevButton.svg";

interface Props {
    count: number;
    carouselName: string;
    class: string;
    showArrows?: boolean;
}

const { count, carouselName, class: className, showArrows = true } = Astro.props;

const arrowClass =
    "size-12 shrink-0 inline-flex items-center justify-center bg-white/90 hover:bg-white text-gray-800 rounded-full shadow-lg transition-all duration-200 cursor-pointer [&[hidden]]:hidden";
---

<div class={className} data-carousel-controls={carouselName}>
    {
        showArrows && (
            <button
                type="button"
                aria-label={`Mostrar elemento anterior de ${carouselName}`}
                class={arrowClass}
                data-carousel-prev
            >
                <PrevButton aria-hidden="true" />
            </button>
        )
    }

    <div class="flex overflow-x-auto max-w-[calc(100vw-8rem)] md:max-w-none" role="group" aria-label={`Paginación de ${carouselName}`}>
        {
            Array.from({ length: count }, (_, index) => (
                <button
                    type="button"
                    aria-label={`Mostrar elemento ${index + 1} de ${carouselName}`}
                    aria-current={index === 0 ? "true" : undefined}
                    class="size-12 shrink-0 inline-flex items-center justify-center rounded-full [&[hidden]]:hidden"
                    data-carousel-dot
                >
                    <span class={`size-3 rounded-full transition-opacity duration-200 ${index === 0 ? "bg-primary" : "bg-gray-300"}`} />
                </button>
            ))
        }
    </div>

    {
        showArrows && (
            <button
                type="button"
                aria-label={`Mostrar elemento siguiente de ${carouselName}`}
                class={arrowClass}
                data-carousel-next
            >
                <NextButton aria-hidden="true" />
            </button>
        )
    }

    <p class="sr-only" aria-live="polite" aria-atomic="true" data-carousel-status>
        Elemento 1 de {count} de {carouselName}
    </p>
</div>

<script>
    function setupCarousel(carousel: HTMLElement) {
        const viewport = carousel.querySelector<HTMLElement>("[data-carousel-viewport]");
        const track = carousel.querySelector<HTMLElement>("[data-carousel-track]");
        if (!viewport || !track) return;

        const slides = Array.from(track.children) as HTMLElement[];
        const dots = Array.from(carousel.querySelectorAll<HTMLElement>("[data-carousel-dot]"));
        const prevButton = carousel.querySelector<HTMLElement>("[data-carousel-prev]");
        const nextButton = carousel.querySelector<HTMLElement>("[data-carousel-next]");
        const status = carousel.querySelector<HTMLElement>("[data-carousel-status]");
        const name = carousel.querySelector<HTMLElement>("[data-carousel-controls]")?.dataset.carouselControls;
        // En el hero solo se ve un slide a la vez; los ocultos no deben recibir foco.
        const oneSlideAtATime = carousel.hasAttribute("data-carousel-single-slide");
        let current = 0;

        // Cuánto se puede mover la lista sin dejar espacio vacío al final.
        const maxOffset = () => Math.max(0, track.scrollWidth - viewport.clientWidth);
        const offsetOf = (index: number) =>
            Math.min(slides[index].offsetLeft - slides[0].offsetLeft, maxOffset());

        // Cuando se ven varios slides, los últimos no se pueden "centrar":
        // el último índice útil es el primero que ya llega al final.
        const lastIndex = () => {
            const index = slides.findIndex((_, i) => offsetOf(i) >= maxOffset());
            return index === -1 ? slides.length - 1 : index;
        };

        function show(index: number, announce = true) {
            current = index;
            track!.style.transform = `translateX(-${offsetOf(index)}px)`;

            const last = lastIndex();
            dots.forEach((dot, i) => {
                dot.hidden = i > last;
                dot.setAttribute("aria-current", String(i === index));
                dot.querySelector("span")?.classList.toggle("bg-primary", i === index);
                dot.querySelector("span")?.classList.toggle("bg-gray-300", i !== index);
            });
            if (prevButton) prevButton.hidden = last === 0;
            if (nextButton) nextButton.hidden = last === 0;

            if (oneSlideAtATime) {
                slides.forEach((slide, i) => {
                    slide.inert = i !== index;
                });
            }

            if (announce && status) {
                status.textContent = `Elemento ${index + 1} de ${slides.length} de ${name}`;
            }
        }

        function move(step: number) {
            const last = lastIndex();
            let next = current + step;
            if (next > last) next = 0;
            if (next < 0) next = last;
            show(next);
        }

        prevButton?.addEventListener("click", () => move(-1));
        nextButton?.addEventListener("click", () => move(1));
        dots.forEach((dot, i) => dot.addEventListener("click", () => show(i)));

        carousel.addEventListener("keydown", (event) => {
            if (event.key === "ArrowLeft") move(-1);
            else if (event.key === "ArrowRight") move(1);
            else return;
            event.preventDefault();
        });

        // Al cambiar el tamaño, recalcula posiciones sin pasarse del último slide.
        new ResizeObserver(() => show(Math.min(current, lastIndex()), false)).observe(viewport);
    }

    document.addEventListener("astro:page-load", () => {
        document.querySelectorAll<HTMLElement>("[data-carousel]").forEach(setupCarousel);
    });
</script>
