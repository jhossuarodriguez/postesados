---
import Container from "@/components/layout/Container.astro";
import ServiceHighlightCard from "@/components/sections/home/ServiceHighlightCard.astro";
import { serviceHighlights } from "@/data/home";
---

<section class="mt-20 flex w-full flex-col bg-tertiary pb-20 md:pb-28">
    <Container class="mt-10 flex flex-col space-y-10">
        <div class="w-fit rounded-full border border-gray-300 lg:px-6 px-3 py-2 bg-white" data-reveal>
            <p class="flex justify-center items-center text-xs lg:text-base text-primary font-bold gap-2">
                ● Nuestros Servicios
            </p>
        </div>

        <div class="flex flex-col lg:flex-row items-center gap-x-20 space-y-3 lg:space-y-0" data-reveal>
            <h2 class="text-3xl lg:text-6xl text-primary w-full lg:max-w-4xl leading-tight">
                Ingeniería Avanzada que <br />
                <span class="font-bold">Impulsa el Desarrollo</span>
            </h2>
        </div>
    </Container>

    <Container class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8" data-reveal-children>
        {serviceHighlights.map((item) => <ServiceHighlightCard item={item} />)}
    </Container>
</section>
