---
import HeroCarousel from "@/components/sections/home/HeroCarousel.astro";
import { heroSlides } from "@/data/home";
---

<section
    class="relative isolate min-h-screen w-full overflow-hidden"
>
    <video
        class="absolute inset-0 -z-20 size-full object-cover"
        src="/new/plaza_multiuso_seibana.webm"
        preload="metadata"
        muted
        loop
        playsinline
        data-viewport-video
        aria-hidden="true"></video>
    <div class="absolute inset-0 -z-10 bg-black/70"></div>

    <div
        class="mx-4 flex flex-col items-center gap-10 px-4 pb-10 pt-40 md:mx-8 md:min-h-screen md:justify-center md:gap-12 md:pb-12 md:pt-32 lg:mx-8 lg:flex-row lg:gap-16 lg:px-4 lg:py-28 xl:gap-20"
    >
        <header
            class="max-w-2xl text-4xl font-medium leading-[1.08] tracking-tighter text-white lg:flex-1"
        >
            <h1 class="page-intro font-bold sm:text-5xl lg:text-5xl leading-[1.15]">
                Transformamos el concreto en soluciones eficientes, seguras y
                duraderas.
            </h1>
        </header>

        <div class="w-full min-w-0 lg:flex-[1.15] lg:self-center">
            <HeroCarousel slides={heroSlides} />
        </div>
    </div>
</section>
