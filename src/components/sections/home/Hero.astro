---
import Container from "@/components/layout/Container.astro";
import HeroCarousel from "@/components/sections/home/HeroCarousel.astro";
import { heroSlides } from "@/data/home";
import { getImage } from "astro:assets";
import heroPhoto from "@/assets/images/hero/hero-poster.avif";

const poster = await getImage({
    src: heroPhoto,
    width: 1280,
    widths: [480, 768, 1280],
    format: "avif",
    quality: 45,
});
---

<section
    class="relative isolate min-h-screen w-full overflow-hidden"
>
    <img
        class="absolute inset-0 -z-20 size-full object-cover"
        src={poster.src}
        srcset={poster.srcSet.attribute}
        sizes="100vw"
        width={poster.attributes.width}
        height={poster.attributes.height}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
    />
    <video
        class="absolute inset-0 -z-20 size-full object-cover motion-reduce:hidden"
        data-lazy-video
        preload="none"
        muted
        loop
        playsinline
        aria-hidden="true"
    >
        <source src="/new/hero-optimized.webm" type='video/webm; codecs="vp9"' />
        <source src="/new/hero-optimized.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 -z-10 bg-black/70"></div>

    <Container
        data-reveal-children
        class="flex flex-col items-center gap-10 pb-10 pt-40 md:min-h-screen md:justify-center md:gap-12 md:pb-12 md:pt-32 lg:flex-row lg:gap-16 lg:py-28 xl:gap-20"
    >
        <header
            class="max-w-2xl text-4xl font-medium leading-[1.08] tracking-tighter text-white lg:flex-1 mt-20 md:mt-0 lg:mt-0 2xl:mt-0"
        >
            <h1 class="font-bold sm:text-5xl lg:text-5xl leading-[1.15]">
                Transformamos el concreto en soluciones eficientes, seguras y
                duraderas.
            </h1>
        </header>

        <div class="w-full min-w-0 lg:flex-[1.15] lg:self-center">
            <HeroCarousel slides={heroSlides} />
        </div>
    </Container>
</section>
