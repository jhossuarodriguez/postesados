---
import Container from "@/components/layout/Container.astro";
import MoveRight from "@/assets/icons/MoveRight.svg";
import StatsGrid from "@/components/ui/StatsGrid.astro";
import { companyStats } from "@/data/company";
---

<Container class="py-16 md:py-24">
    <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-start" data-reveal-children>
        <div class="flex-1 flex flex-col gap-8">
            <h2 class="text-4xl md:text-6xl lg:text-7xl 2xl:text-8xl font-bold tracking-tighter text-primary leading-tight">
                Precisión técnica en la puesta en servicio
            </h2>
            <a
                href="/contact"
                class="group text-sm lg:text-base font-bold inline-flex min-h-12 items-center bg-primary text-white px-4 py-2 lg:px-4 lg:py-2 rounded-full hover:bg-gray-100 hover:text-primary transition shadow-lg mt-8 self-start"
            >
                Contáctanos
                <MoveRight
                    aria-hidden="true"
                    class="inline-block ml-2 group-hover:translate-x-1 duration-75"
                />
            </a>
        </div>
        <div class="flex-1 w-full">
            <StatsGrid stats={companyStats} />
        </div>
    </div>
</Container>
