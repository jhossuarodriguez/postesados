---
import CardGridSection from "@/components/ui/CardGridSection.astro";
import FeatureCard from "@/components/ui/FeatureCard.astro";
import { technologies } from "@/data/technology";
---

<CardGridSection title="Tecnología aplicada al hormigón presforzado">
    {
        technologies.map((technology) => (
            <FeatureCard
                title={technology.title}
                description={technology.description}
                image={technology.image}
                imageAlt={technology.imageAlt}
            />
        ))
    }
</CardGridSection>
