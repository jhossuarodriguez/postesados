---
import { Image } from "astro:assets";
import { projects } from "@/data/projects";
---

<div class="md:max-w-335 lg:max-w-400 mx-auto md:px-5 lg:px-5 pb-16 md:pb-24">
    <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mx-5 md:mx-0"
        data-reveal-children
    >
        {
            projects.map((project) => (
                <div class="group/card relative overflow-hidden h-72 md:h-80 cursor-pointer">
                    <Image
                        src={project.image}
                        alt={project.title}
                        class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover/card:scale-105"
                    />
                    <div class="absolute inset-0 bg-linear-to-t from-black/60 via-black/10 to-transparent" />
                    <div class="absolute bottom-0 left-0 right-0 p-5 md:p-6">
                        <span class="inline-block text-xs font-bold text-primary bg-white px-3 py-1.5 rounded-full mb-3">
                            {project.category}
                        </span>
                        <h3 class="text-white text-lg md:text-xl font-bold leading-snug">
                            {project.title}
                        </h3>
                    </div>
                </div>
            ))
        }
    </div>
</div>
