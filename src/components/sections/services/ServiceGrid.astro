---
import CardGridSection from "@/components/ui/CardGridSection.astro";
import FeatureCard from "@/components/ui/FeatureCard.astro";
import { services } from "@/data/services";
---

<CardGridSection title="Experiencia en ingeniería estructural a su servicio">
    {
        services.map((service) => (
            // El id mantiene vivos los enlaces antiguos tipo /servicios#postesado.
            <div id={service.id}>
                <FeatureCard
                    title={service.title}
                    description={service.description}
                    image={service.image}
                    imageAlt={service.imageAlt}
                />
                <a href={`/servicios/${service.id}`} class="mt-2 flex min-h-12 items-center px-4 text-sm font-bold text-primary underline underline-offset-4">Explorar {service.title.toLowerCase()}</a>
            </div>
        ))
    }
</CardGridSection>
