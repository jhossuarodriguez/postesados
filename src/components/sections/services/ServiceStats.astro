---
import MoveRight from "@/assets/icons/MoveRight.svg";
import StatsGrid from "@/components/ui/StatsGrid.astro";
import { companyStats } from "@/data/company";
---

<div class="md:max-w-335 lg:max-w-400 mx-auto md:px-5 lg:px-5 py-16 md:py-24">
    <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-center mx-5 md:mx-0" data-reveal-children>
        <div class="flex-1 flex flex-col gap-8">
            <p
                class="flex items-center text-xs lg:text-base text-primary font-bold px-3 py-2 self-start bg-white rounded-full border border-gray-300"
            >
                ● Capacidad técnica
            </p>
            <h2
                class="text-4xl md:text-6xl lg:text-7xl 2xl:text-8xl font-bold tracking-tighter text-primary leading-22"
            >
                Optimizando la infraestructura <span class="font-bold">de inicio</span
                > a <span class="text-primary">final</span>
            </h2>
            <a
                href="/contact"
                class="min-h-12 text-sm lg:text-base font-bold inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-full hover:bg-[#002080] transition shadow-lg self-start"
            >
                Contáctenos
                <MoveRight
                    class="inline-block ml-2 group-hover:animate-slide-in-left duration-75"
                />
            </a>
        </div>
        <div class="flex-1 w-full">
            <StatsGrid stats={companyStats} />
        </div>
    </div>
</div>
