---
import FeatureCard from "@/components/ui/FeatureCard.astro";
import { impacts } from "@/data/about";
---

<div
    id="compromiso-tecnico"
    class="bg-tertiary w-full mx-auto px-6 md:px-10 lg:px-16 py-12 md:py-16 lg:py-20"
>
    <h2
        class="text-3xl md:text-5xl 2xl:text-6xl font-bold tracking-tighter text-center mb-10 md:mb-14 text-primary"
        data-reveal="up"
    >
        Nuestro compromiso técnico
    </h2>
    <div
        class="grid grid-cols-1 sm:grid-cols-2 2xl:grid-cols-3 gap-4 md:gap-6 2xl:gap-8 max-w-7xl 2xl:max-w-425 mx-auto"
        data-reveal-children
    >
        {
            impacts.map((impact) => (
                <FeatureCard
                    title={impact.title}
                    description={impact.description}
                    image={impact.image}
                    imageAlt={impact.imageAlt}
                />
            ))
        }
    </div>
</div>
