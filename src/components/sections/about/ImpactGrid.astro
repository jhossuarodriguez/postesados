---
import CardGridSection from "@/components/ui/CardGridSection.astro";
import FeatureCard from "@/components/ui/FeatureCard.astro";
import { impacts } from "@/data/about";
---

<CardGridSection id="compromiso-tecnico" title="Nuestro compromiso técnico">
    {
        impacts.map((impact) => (
            <FeatureCard
                title={impact.title}
                description={impact.description}
                image={impact.image}
                imageAlt={impact.imageAlt}
            />
        ))
    }
</CardGridSection>
