---
import Container from "@/components/layout/Container.astro";
import NumberedCard from "@/components/ui/NumberedCard.astro";
import { companies } from "@/data/about";
---

<Container as="section" class="py-16">
    <h2 class="mb-8 text-3xl font-bold tracking-tight text-primary md:text-5xl" data-reveal>Capacidades de Postesados JHP</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16" data-reveal-children>
        {
            companies.map((company) => (
                <NumberedCard
                    title={company.title}
                    description={company.description}
                    number={company.number}
                    accent={company.accent}
                />
            ))
        }
    </div>
</Container>
