---
export const prerender = false
import SiteLayout from "@/layouts/SiteLayout.astro";
import PhotoCta from "@/components/sections/shared/PhotoCta.astro";
import imgPuente from "@/assets/images/SERVICE_SECTION/puente-rio-cachon-vista-aerea-lateral.avif";
import InteriorHero from "@/components/sections/shared/InteriorHero.astro";
import imgBgBackground from "@/assets/images/bgBackground.avif";
import CompanyGrid from "@/components/sections/about/CompanyGrid.astro";
import ImpactGrid from "@/components/sections/about/ImpactGrid.astro";
---

<SiteLayout
    title="Nosotros | Postesados JHP"
    description="Empresa especializada en diseño, fabricación y suministro de elementos prefabricados de hormigón armado y pretensado."
>
    <section>
        <InteriorHero
            image={imgBgBackground}
            imageAlt="Fondo de la empresa"
        >
            <Fragment slot="title">Nosotros</Fragment>
            Combinamos diseño, capacidad productiva y atención especializada para
            desarrollar soluciones estructurales eficientes, seguras y duraderas.
        </InteriorHero>
        <CompanyGrid />
        <ImpactGrid />
        <PhotoCta
            image={imgPuente}
            imageAlt="Personas trabajando footer image"
            label="● Conversemos"
            title="Da el Siguiente Paso"
            description="Ya sea que requiera un diseño estructural optimizado o una ejecución precisa de postensado, estamos listos para reforzar su proyecto con eficiencia ingenieril."
            href="/proyectos"
            linkLabel="Proyectos"
        />
    </section>
</SiteLayout>
