---
export const prerender = false
import SiteLayout from "@/layouts/SiteLayout.astro";
import PhotoCta from "@/components/sections/shared/PhotoCta.astro";
import imgPuente from "@/assets/images/service_section/puente-rio-cachon-vista-aerea-lateral.avif";
import TechnologyGrid from "@/components/sections/technology/TechnologyGrid.astro";
import InteriorHero from "@/components/sections/shared/InteriorHero.astro";
import TechnologyStats from "@/components/sections/technology/TechnologyStats.astro";
---

<SiteLayout
    title="Tecnología de presfuerzo | Postesados JHP"
    description="Tecnología, equipos y control técnico para la fabricación, instalación, tensado e inyección de sistemas de pretensado y postensado."
>
    <section>
        <InteriorHero
            image="/new/nuestros_servicios_gatos_hidraulicos_para_pretensar_3.avif"
            imageAlt="Equipos hidráulicos para sistemas de hormigón presforzado"
        >
            <Fragment slot="title">Tecnología</Fragment>
            Aplicamos moldes industriales, equipos hidráulicos y procesos controlados
            para fabricar, instalar y proteger sistemas de hormigón pretensado y
            postensado con precisión y seguridad.
        </InteriorHero>
        <TechnologyStats />
        <TechnologyGrid />
        <PhotoCta
            image={imgPuente}
            imageAlt="Vista aérea del puente Río Cachón"
            label="● Ingeniería especializada"
            title="Optimicemos tu Próximo Proyecto"
            description="Integramos materiales, equipos y control técnico para desarrollar soluciones estructurales eficientes, seguras y duraderas."
            href="/contact"
            linkLabel="Contáctenos"
        />
    </section>
</SiteLayout>
