---
export const prerender = false
import SiteLayout from "@/layouts/SiteLayout.astro";
import PhotoCta from "@/components/sections/shared/PhotoCta.astro";
import imgPuente from "@/assets/images/service_section/puente-rio-cachon-vista-aerea-lateral.avif";
import imgHormigonPostensado from "@/assets/images/projects/nuestros_servicios_hormigon_postensado_proyecto_2.avif";
import ServiceGrid from "@/components/sections/services/ServiceGrid.astro";
import InteriorHero from "@/components/sections/shared/InteriorHero.astro";
import ServiceStats from "@/components/sections/services/ServiceStats.astro";
---

<SiteLayout
    title="Servicios y productos | Postesados JHP"
    description="Diseño, fabricación y suministro de hormigón pretensado, postensado y armado, prefabricados, tensado e inyección de lechada."
>
    <section>
        <InteriorHero
            image={imgHormigonPostensado}
            imageAlt="Estructura de hormigón postensado ejecutada por Postesados JHP"
        >
            <Fragment slot="title">Servicios</Fragment>
            Diseñamos, fabricamos y suministramos soluciones de hormigón pretensado,
            postensado y armado, desde elementos prefabricados hasta instalación,
            tensado e inyección especializada.
        </InteriorHero>
        <ServiceStats />
        <ServiceGrid />
        <PhotoCta
            image={imgPuente}
            imageAlt="Vista aérea del puente Río Cachón"
            label="● Conversemos"
            title="Da el Siguiente Paso"
            description="Ya sea que requiera un diseño estructural optimizado o una ejecución precisa de postensado, estamos listos para reforzar su proyecto con eficiencia ingenieril."
            href="/contact"
            linkLabel="Contáctanos"
        />
    </section>
</SiteLayout>
