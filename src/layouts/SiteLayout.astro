---
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import Layout from "@/layouts/Layout.astro";
import type { ComponentProps } from "astro/types";
import { pageDetails } from "@/data/seo";

type Props = ComponentProps<typeof Layout>;

const { breadcrumbs, ...layoutProps } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const label = pageDetails[path]?.label;
// Si la página no trae sus migas, se generan "Inicio > Página" a partir de pageDetails.
const defaultBreadcrumbs = label ? [{ name: "Inicio", path: "/" }, { name: label, path }] : [];
---

<Layout {...layoutProps} breadcrumbs={breadcrumbs ?? defaultBreadcrumbs}>
	<a href="#contenido" class="skip-link">Saltar al contenido</a>
	<Header />
	<main id="contenido" tabindex="-1">
		<slot />
	</main>
	<Footer />
</Layout>
