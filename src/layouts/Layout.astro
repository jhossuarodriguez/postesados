---
import "@/styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Postesados JHP | Soluciones estructurales en hormigón",
	description = "Diseño, fabricación y suministro de elementos prefabricados de hormigón armado, pretensado y postensado para infraestructura y edificación.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_DO" />
		<meta property="og:site_name" content="Postesados JHP" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<link
			rel="icon"
			type="image/png"
			href="/favicon-96x96.png"
			sizes="96x96"
		/>
		<!-- Preload fuentes críticas para LCP -->
		<link rel="preload" href="/fonts/montserrat-v31-latin-300.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/montserrat-v31-latin-700.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/montserrat-v31-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/montserrat-v31-latin-500.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/GeneralSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
	</head>
	<body class="w-full mx-auto">
		<slot />
	</body>
</html>

<script>
	import {
		destroyViewportVideos,
		initializeViewportVideos,
	} from "@/lib/viewport-videos";
	import {
		destroyScrollAnimations,
		initializeScrollAnimations,
	} from "@/lib/scroll-animations";

	initializeScrollAnimations();
	initializeViewportVideos();
	document.addEventListener("astro:page-load", () => {
		initializeScrollAnimations();
		initializeViewportVideos();
	});
	document.addEventListener("astro:before-swap", () => {
		destroyScrollAnimations();
		destroyViewportVideos();
	});
</script>

<style>
	html {
		margin: 0;
		width: 100%;
		height: 100%;
		font-family: "Montserrat", sans-serif;
	}

	body {
		margin: 0;
		width: 100%;
		height: 100%;
		font-family: "Montserrat", sans-serif;
		overflow-y: scroll;
	}

	html.lenis,
	html.lenis body {
		height: auto;
	}
</style>
